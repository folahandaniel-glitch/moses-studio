# Required. PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Required. Random string, at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Required for the first administrator (read only when no admin exists yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Moses Studio Admin

# Public site URL (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Image storage. On Vercel create a Blob store and paste its token. Without it, uploads go to public/uploads (local development only).
BLOB_READ_WRITE_TOKEN=

# Optional. Contact form email notifications through Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Moses Studio <onboarding@resend.dev>
CONTACT_NOTIFY_EMAIL=
